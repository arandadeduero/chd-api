<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estación <%= stationId.toUpperCase() %> · <%= type.charAt(0).toUpperCase() + type.slice(1) %> · CHD</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.min.js"></script>
    <style>
      :root {
        --bg-base:      #0d1117;
        --bg-surface:   #161b22;
        --bg-elevated:  #1c2128;
        --bg-subtle:    #21262d;
        --border:       #30363d;
        --border-muted: #21262d;
        --text-primary: #e6edf3;
        --text-secondary: #8b949e;
        --text-muted:   #6e7681;
        --accent:       #388bfd;
        --accent-hover: #58a6ff;
        --accent-dim:   rgba(56, 139, 253, 0.15);
        --success:      #3fb950;
        --warning:      #d29922;
        --danger:       #f85149;
        --purple:       #bc8cff;
        --teal:         #39d353;
        --orange:       #f0883e;
        --radius-sm:    6px;
        --radius-md:    10px;
        --radius-lg:    16px;
        --shadow-sm:    0 1px 3px rgba(0,0,0,0.4);
        --shadow-md:    0 4px 12px rgba(0,0,0,0.5);
        --shadow-lg:    0 8px 32px rgba(0,0,0,0.6);
      }

      *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg-base);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      /* ── Layout ── */
      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px 48px;
      }

      /* ── Top nav bar ── */
      .topbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .topbar-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-decoration: none;
        letter-spacing: 0.02em;
      }

      .topbar-logo svg {
        color: var(--accent);
      }

      .topbar-sep {
        color: var(--border);
        font-size: 1.2rem;
        user-select: none;
      }

      .topbar-crumb {
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .topbar-crumb a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.15s;
      }
      .topbar-crumb a:hover { color: var(--accent-hover); }

      .topbar-actions {
        margin-left: auto;
        display: flex;
        gap: 8px;
      }

      /* ── Header ── */
      .page-header {
        margin-bottom: 28px;
      }

      .page-header-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
      }

      .page-title {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        line-height: 1.2;
      }

      .page-title span {
        color: var(--accent);
      }

      .page-subtitle {
        margin-top: 6px;
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        border: 1px solid;
      }

      .badge-nivel {
        background: rgba(57, 211, 83, 0.12);
        color: var(--teal);
        border-color: rgba(57, 211, 83, 0.3);
      }

      .badge-caudal {
        background: rgba(56, 139, 253, 0.12);
        color: var(--accent-hover);
        border-color: rgba(56, 139, 253, 0.3);
      }

      .badge-temperatura {
        background: rgba(210, 153, 34, 0.12);
        color: var(--warning);
        border-color: rgba(210, 153, 34, 0.3);
      }

      .badge-pluviometria {
        background: rgba(240, 136, 62, 0.12);
        color: var(--orange);
        border-color: rgba(240, 136, 62, 0.3);
      }

      .badge-default {
        background: rgba(188, 140, 255, 0.12);
        color: var(--purple);
        border-color: rgba(188, 140, 255, 0.3);
      }

      /* ── Stats grid ── */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
      }

      .stat-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 18px 20px;
        position: relative;
        overflow: hidden;
        transition: border-color 0.2s, transform 0.2s;
      }

      .stat-card:hover {
        border-color: var(--accent);
        transform: translateY(-1px);
      }

      .stat-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 2px;
      }

      .stat-card.card-total::before  { background: var(--accent); }
      .stat-card.card-min::before    { background: var(--success); }
      .stat-card.card-max::before    { background: var(--danger); }
      .stat-card.card-avg::before    { background: var(--warning); }
      .stat-card.card-p5::before     { background: var(--purple); }
      .stat-card.card-period::before { background: var(--text-muted); }

      .stat-icon {
        width: 32px;
        height: 32px;
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
      }

      .stat-card.card-total  .stat-icon { background: rgba(56,139,253,0.15); color: var(--accent); }
      .stat-card.card-min    .stat-icon { background: rgba(63,185,80,0.15);  color: var(--success); }
      .stat-card.card-max    .stat-icon { background: rgba(248,81,73,0.15);  color: var(--danger); }
      .stat-card.card-avg    .stat-icon { background: rgba(210,153,34,0.15); color: var(--warning); }
      .stat-card.card-p5     .stat-icon { background: rgba(188,140,255,0.15);color: var(--purple); }
      .stat-card.card-period .stat-icon { background: rgba(110,118,129,0.15);color: var(--text-muted); }

      .stat-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 4px;
      }

      .stat-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
      }

      .stat-unit {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-left: 2px;
      }

      .stat-sub {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-top: 2px;
      }

      /* ── Toolbar ── */
      .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        flex-wrap: wrap;
      }

      .toolbar-group {
        display: flex;
        align-items: center;
        gap: 4px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 4px;
      }

      .toolbar-label {
        font-size: 0.78rem;
        color: var(--text-muted);
        font-weight: 500;
        padding: 0 8px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: var(--radius-sm);
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        border: none;
        text-decoration: none;
        transition: background 0.15s, color 0.15s, box-shadow 0.15s;
        white-space: nowrap;
      }

      .btn-ghost {
        background: transparent;
        color: var(--text-secondary);
      }
      .btn-ghost:hover {
        background: var(--bg-subtle);
        color: var(--text-primary);
      }

      .btn-ghost.active {
        background: var(--accent-dim);
        color: var(--accent-hover);
      }

      .btn-primary {
        background: var(--accent);
        color: #fff;
      }
      .btn-primary:hover {
        background: var(--accent-hover);
        box-shadow: 0 0 0 3px rgba(56,139,253,0.3);
      }

      .btn-outline {
        background: transparent;
        color: var(--text-secondary);
        border: 1px solid var(--border);
      }
      .btn-outline:hover {
        border-color: var(--accent);
        color: var(--accent-hover);
        background: var(--accent-dim);
      }

      .toolbar-spacer { flex: 1; }

      .btn-icon {
        padding: 7px 10px;
      }

      /* ── Chart container ── */
      .chart-wrapper {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 20px;
        margin-bottom: 20px;
        position: relative;
      }

      .chart-container {
        position: relative;
        height: 440px;
      }

      /* ── Footer actions ── */
      .footer-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding-top: 20px;
        border-top: 1px solid var(--border-muted);
      }

      .footer-meta {
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      .footer-meta strong {
        color: var(--text-secondary);
        font-weight: 500;
      }

      /* ── Responsive ── */
      @media (max-width: 640px) {
        .page { padding: 0 16px 32px; }
        .page-title { font-size: 1.35rem; }
        .stats-grid { grid-template-columns: 1fr 1fr; }
        .chart-container { height: 300px; }
        .toolbar { gap: 6px; }
        .topbar-crumb { display: none; }
      }

      @media (max-width: 400px) {
        .stats-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="page">

      <!-- Top navigation -->
      <nav class="topbar">
        <a href="/graph" class="topbar-logo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          CHD API
        </a>
        <span class="topbar-sep">/</span>
        <div class="topbar-crumb">
          <a href="/graph">Estaciones</a>
          <span style="margin: 0 6px; color: var(--border)">/</span>
          <a href="/graph/<%= stationId %>">Estación <%= stationId.toUpperCase() %></a>
          <span style="margin: 0 6px; color: var(--border)">/</span>
          <span><%= type.charAt(0).toUpperCase() + type.slice(1) %></span>
        </div>
        <div class="topbar-actions">
          <a href="/station/aforo/<%= stationId %>/<%= typeSlug %>" class="btn btn-outline btn-icon" title="Ver JSON">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
            JSON
          </a>
        </div>
      </nav>

      <!-- Header -->
      <header class="page-header">
        <div class="page-header-top">
          <div>
            <h1 class="page-title">
              Estación <span><%= stationId.toUpperCase() %></span>
            </h1>
            <p class="page-subtitle">Confederación Hidrográfica del Duero · SAIH Duero</p>
          </div>
          <div class="badge badge-<%= typeSlug %>">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="12" cy="12" r="6"/>
            </svg>
            <%= type.toUpperCase() %>
          </div>
        </div>
      </header>

      <!-- Stats -->
      <div class="stats-grid">
        <div class="stat-card card-total">
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
          </div>
          <div class="stat-label">Mediciones</div>
          <div class="stat-value"><%= stats.total.toLocaleString('es-ES') %></div>
          <div class="stat-sub"><%= stats.startDate %></div>
        </div>

        <div class="stat-card card-min">
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/>
            </svg>
          </div>
          <div class="stat-label">Mínimo</div>
          <div class="stat-value">
            <%= stats.min !== null ? stats.min.toFixed(2) : '—' %><span class="stat-unit" id="unit-min"></span>
          </div>
        </div>

        <div class="stat-card card-max">
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
            </svg>
          </div>
          <div class="stat-label">Máximo</div>
          <div class="stat-value">
            <%= stats.max !== null ? stats.max.toFixed(2) : '—' %><span class="stat-unit" id="unit-max"></span>
          </div>
        </div>

        <div class="stat-card card-avg">
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
            </svg>
          </div>
          <div class="stat-label">Promedio</div>
          <div class="stat-value">
            <%= stats.avg !== null ? stats.avg.toFixed(2) : '—' %><span class="stat-unit" id="unit-avg"></span>
          </div>
        </div>

        <div class="stat-card card-p5">
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6" stroke-dasharray="3 3"/><line x1="3" y1="18" x2="21" y2="18" stroke-dasharray="3 3"/>
            </svg>
          </div>
          <div class="stat-label">Percentil 5%</div>
          <div class="stat-value" id="p5-value">—</div>
          <div class="stat-sub" id="p5-sub">umbral mínimo histórico</div>
        </div>

        <div class="stat-card card-period">
          <div class="stat-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="stat-label">Período</div>
          <div class="stat-value" style="font-size:1rem"><%= stats.startDate.split(' ')[0] %></div>
          <div class="stat-sub">hasta <%= stats.endDate.split(' ')[0] %></div>
        </div>
      </div>

      <!-- Toolbar -->
      <div class="toolbar">
        <div class="toolbar-group">
          <span class="toolbar-label">Rango</span>
          <button class="btn btn-ghost" id="range-24h" onclick="setRange(24)">24 h</button>
          <button class="btn btn-ghost" id="range-7d"  onclick="setRange(168)">7 d</button>
          <button class="btn btn-ghost active" id="range-all" onclick="setRange(null)">Todo</button>
        </div>

        <div class="toolbar-group">
          <button class="btn btn-ghost btn-icon" onclick="myChart.zoom(1.15)" title="Zoom in">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </button>
          <button class="btn btn-ghost btn-icon" onclick="myChart.zoom(0.87)" title="Zoom out">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/>
            </svg>
          </button>
          <button class="btn btn-ghost btn-icon" onclick="resetZoom()" title="Resetear zoom">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.99"/>
            </svg>
          </button>
        </div>

        <span class="toolbar-spacer"></span>
        <span style="font-size:0.75rem; color:var(--text-muted)">Arrastra para desplazar · Rueda para zoom</span>
      </div>

      <!-- Chart -->
      <div class="chart-wrapper">
        <canvas id="myChart" class="chart-container"></canvas>
      </div>

      <!-- Footer -->
      <div class="footer-row">
        <div class="footer-meta">
          <strong>CHD API</strong> · Confederación Hidrográfica del Duero · Datos SAIH Duero
        </div>
        <div style="display:flex; gap:8px">
          <a href="/graph/<%= stationId %>" class="btn btn-outline">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
            </svg>
            Estación
          </a>
          <a href="/station/aforo/<%= stationId %>/<%= typeSlug %>" class="btn btn-outline">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
            </svg>
            Ver JSON
          </a>
        </div>
      </div>

    </div><!-- /page -->

    <script>
      const RAW_DATA  = <%- JSON.stringify(chartData) %>;
      const STAT_AVG  = <%= stats.avg !== null ? stats.avg : 'null' %>;
      const TYPE_NAME = '<%= type %>';
      const TYPE_SLUG = '<%= typeSlug %>';

      // Unit labels
      const UNIT = TYPE_SLUG === 'caudal'       ? 'm³/s' :
                   TYPE_SLUG === 'nivel'         ? 'm'    :
                   TYPE_SLUG === 'temperatura'   ? '°C'   :
                   TYPE_SLUG === 'pluviometria'  ? 'mm'   : '';

      // Inject units into stat cards
      document.querySelectorAll('.stat-unit').forEach(el => el.textContent = UNIT ? ' ' + UNIT : '');

      // Percentile helper
      function percentile(arr, p) {
        const sorted = [...arr].sort((a, b) => a - b);
        const idx = (p / 100) * (sorted.length - 1);
        const lo = Math.floor(idx), hi = Math.ceil(idx);
        return sorted[lo] + (sorted[hi] - sorted[lo]) * (idx - lo);
      }

      const values = RAW_DATA.map(d => d.v).filter(v => typeof v === 'number' && isFinite(v));
      const P5 = values.length > 0 ? percentile(values, 5) : null;

      if (P5 !== null) {
        document.getElementById('p5-value').innerHTML =
          P5.toFixed(2) + (UNIT ? '<span class="stat-unit"> ' + UNIT + '</span>' : '');
      }

      // Build time-series dataset
      const allPoints = RAW_DATA.map(item => ({
        x: new Date(item['@timestamp']),
        y: item.v
      }));

      // Accent colour per type
      const ACCENT_RGB = TYPE_SLUG === 'nivel'        ? '57, 211, 83'   :
                         TYPE_SLUG === 'caudal'       ? '56, 139, 253'  :
                         TYPE_SLUG === 'temperatura'  ? '210, 153, 34'  :
                         TYPE_SLUG === 'pluviometria' ? '240, 136, 62'  : '188, 140, 255';

      const P5_LINE_PLUGIN = {
        id: 'p5line',
        afterDraw(chart) {
          if (P5 === null) return;
          const {ctx, scales: {x, y}, chartArea} = chart;
          const yPos = y.getPixelForValue(P5);
          if (yPos < chartArea.top || yPos > chartArea.bottom) return;

          ctx.save();
          ctx.setLineDash([6, 4]);
          ctx.lineWidth = 1.5;
          ctx.strokeStyle = 'rgba(188, 140, 255, 0.7)';
          ctx.beginPath();
          ctx.moveTo(chartArea.left, yPos);
          ctx.lineTo(chartArea.right, yPos);
          ctx.stroke();

          ctx.setLineDash([]);
          ctx.fillStyle = 'rgba(188, 140, 255, 0.85)';
          ctx.font = '500 11px Inter, sans-serif';
          ctx.textAlign = 'right';
          ctx.fillText('P5 ' + P5.toFixed(2) + (UNIT ? ' ' + UNIT : ''), chartArea.right - 6, yPos - 5);
          ctx.restore();
        }
      };

      const myChart = new Chart(document.getElementById('myChart'), {
        type: 'line',
        plugins: [P5_LINE_PLUGIN],
        data: {
          datasets: [{
            label: TYPE_NAME.charAt(0).toUpperCase() + TYPE_NAME.slice(1) + (UNIT ? ' (' + UNIT + ')' : ''),
            data: allPoints,
            borderColor: `rgb(${ACCENT_RGB})`,
            backgroundColor: `rgba(${ACCENT_RGB}, 0.08)`,
            borderWidth: 1.5,
            tension: 0.3,
            fill: true,
            pointRadius: 0,
            pointHoverRadius: 5,
            pointHoverBackgroundColor: `rgb(${ACCENT_RGB})`,
            pointHoverBorderColor: '#161b22',
            pointHoverBorderWidth: 2,
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 400 },
          interaction: { intersect: false, mode: 'index' },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              align: 'end',
              labels: {
                color: '#8b949e',
                font: { family: 'Inter, sans-serif', size: 12, weight: '500' },
                usePointStyle: true,
                pointStyle: 'line',
                boxWidth: 24,
                padding: 16,
              }
            },
            tooltip: {
              backgroundColor: '#1c2128',
              borderColor: '#30363d',
              borderWidth: 1,
              padding: { top: 10, bottom: 10, left: 14, right: 14 },
              cornerRadius: 8,
              titleColor: '#8b949e',
              bodyColor: '#e6edf3',
              titleFont: { family: 'Inter, sans-serif', size: 11, weight: '500' },
              bodyFont:  { family: 'Inter, sans-serif', size: 13, weight: '600' },
              callbacks: {
                title(ctx) {
                  return new Date(ctx[0].parsed.x).toLocaleString('es-ES', {
                    day: '2-digit', month: 'short', year: 'numeric',
                    hour: '2-digit', minute: '2-digit'
                  });
                },
                label(ctx) {
                  const val = ctx.parsed.y;
                  const diff = P5 !== null ? (val - P5).toFixed(2) : null;
                  const sign = diff >= 0 ? '+' : '';
                  const lines = [
                    `  ${TYPE_NAME}: ${val.toFixed(2)}${UNIT ? ' ' + UNIT : ''}`
                  ];
                  if (P5 !== null) {
                    lines.push(`  vs P5:  ${sign}${diff}${UNIT ? ' ' + UNIT : ''}`);
                  }
                  return lines;
                },
                labelColor(ctx) {
                  return {
                    backgroundColor: `rgb(${ACCENT_RGB})`,
                    borderColor: 'transparent',
                    borderRadius: 2,
                  };
                }
              }
            },
            zoom: {
              zoom: { wheel: { enabled: true }, pinch: { enabled: true }, mode: 'x' },
              pan:  { enabled: true, mode: 'x' },
              limits: { x: { min: 'original', max: 'original' } }
            }
          },
          scales: {
            x: {
              type: 'time',
              time: {
                displayFormats: {
                  hour:  'dd/MM HH:mm',
                  day:   'dd MMM',
                  week:  'dd MMM',
                  month: 'MMM yyyy',
                }
              },
              ticks: {
                color: '#6e7681',
                maxRotation: 0,
                font: { family: 'Inter, sans-serif', size: 11 },
                maxTicksLimit: 10,
              },
              grid: { color: 'rgba(48, 54, 61, 0.8)' },
              border: { color: '#30363d' },
            },
            y: {
              beginAtZero: false,
              title: {
                display: !!UNIT,
                text: UNIT,
                color: '#6e7681',
                font: { family: 'Inter, sans-serif', size: 11, weight: '500' },
                padding: { bottom: 8 },
              },
              ticks: {
                color: '#6e7681',
                font: { family: 'Inter, sans-serif', size: 11 },
                callback: v => v.toFixed(2),
              },
              grid: { color: 'rgba(48, 54, 61, 0.8)' },
              border: { color: '#30363d' },
            }
          }
        }
      });

      // ── Range selector ──
      function setRange(hours) {
        ['24h','7d','all'].forEach(id =>
          document.getElementById('range-' + id).classList.remove('active'));

        if (hours === null) {
          document.getElementById('range-all').classList.add('active');
          myChart.resetZoom();
          return;
        }

        const now  = new Date(allPoints[allPoints.length - 1].x);
        const from = new Date(now.getTime() - hours * 3600 * 1000);

        myChart.zoomScale('x', { min: from.getTime(), max: now.getTime() });
        document.getElementById('range-' + (hours === 24 ? '24h' : '7d')).classList.add('active');
      }

      function resetZoom() {
        setRange(null);
      }
    </script>
  </body>
</html>
