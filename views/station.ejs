<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estación <%= stationId.toUpperCase() %> · CHD</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-base:        #0d1117;
        --bg-surface:     #161b22;
        --bg-elevated:    #1c2128;
        --bg-subtle:      #21262d;
        --border:         #30363d;
        --border-muted:   #21262d;
        --text-primary:   #e6edf3;
        --text-secondary: #8b949e;
        --text-muted:     #6e7681;
        --accent:         #388bfd;
        --accent-hover:   #58a6ff;
        --accent-dim:     rgba(56, 139, 253, 0.15);
        --success:        #3fb950;
        --teal:           #39d353;
        --warning:        #d29922;
        --orange:         #f0883e;
        --radius-sm:      6px;
        --radius-md:      10px;
        --radius-lg:      16px;
        --shadow-md:      0 4px 12px rgba(0,0,0,0.5);
      }

      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg-base);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px 48px;
      }

      /* Topbar */
      .topbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .topbar-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-decoration: none;
        letter-spacing: 0.02em;
      }
      .topbar-logo svg { color: var(--accent); }

      .topbar-sep { color: var(--border); font-size: 1.2rem; user-select: none; }

      .topbar-crumb {
        font-size: 0.85rem;
        color: var(--text-muted);
      }
      .topbar-crumb a {
        color: var(--text-secondary);
        text-decoration: none;
        transition: color 0.15s;
      }
      .topbar-crumb a:hover { color: var(--accent-hover); }

      /* Header */
      .page-header { margin-bottom: 32px; }

      .station-id-badge {
        font-family: 'SFMono-Regular', 'Consolas', monospace;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--accent-hover);
        background: var(--accent-dim);
        border: 1px solid rgba(56, 139, 253, 0.3);
        padding: 4px 12px;
        border-radius: var(--radius-sm);
        display: inline-block;
        margin-bottom: 12px;
      }

      .page-title {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }
      .page-subtitle {
        margin-top: 6px;
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      /* Meta grid */
      .meta-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 18px;
      }
      .meta-item {}
      .meta-label {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 2px;
      }
      .meta-value {
        font-size: 0.9rem;
        color: var(--text-secondary);
        font-weight: 500;
      }

      /* Data type cards */
      .section-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 14px;
      }

      .type-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 16px;
      }

      .type-card {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 24px;
        text-decoration: none;
        color: inherit;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
        position: relative;
        overflow: hidden;
      }
      .type-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
      }
      .type-card.card-nivel::before        { background: var(--teal); }
      .type-card.card-caudal::before       { background: var(--accent); }
      .type-card.card-temperatura::before  { background: var(--warning); }
      .type-card.card-pluviometria::before { background: var(--orange); }

      .type-card:hover {
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
      }
      .type-card.card-nivel:hover        { border-color: var(--teal); }
      .type-card.card-caudal:hover       { border-color: var(--accent-hover); }
      .type-card.card-temperatura:hover  { border-color: var(--warning); }
      .type-card.card-pluviometria:hover { border-color: var(--orange); }

      .type-icon {
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .type-card.card-nivel        .type-icon { background: rgba(57,211,83,0.12);   color: var(--teal); }
      .type-card.card-caudal       .type-icon { background: rgba(56,139,253,0.12);  color: var(--accent-hover); }
      .type-card.card-temperatura  .type-icon { background: rgba(210,153,34,0.12);  color: var(--warning); }
      .type-card.card-pluviometria .type-icon { background: rgba(240,136,62,0.12);  color: var(--orange); }

      .type-body { flex: 1; }

      .type-name {
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 4px;
        text-transform: capitalize;
      }
      .type-card.card-nivel        .type-name { color: var(--teal); }
      .type-card.card-caudal       .type-name { color: var(--accent-hover); }
      .type-card.card-temperatura  .type-name { color: var(--warning); }
      .type-card.card-pluviometria .type-name { color: var(--orange); }

      .type-desc {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 10px;
      }

      .type-unit {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        padding: 3px 8px;
        border-radius: 20px;
        font-family: 'SFMono-Regular', 'Consolas', monospace;
      }

      .type-arrow {
        color: var(--text-muted);
        flex-shrink: 0;
        transition: color 0.15s, transform 0.15s;
      }
      .type-card:hover .type-arrow {
        color: var(--accent-hover);
        transform: translateX(3px);
      }

      /* No data */
      .no-data {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 40px;
        text-align: center;
        color: var(--text-muted);
      }

      /* Back link */
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.85rem;
        color: var(--text-secondary);
        text-decoration: none;
        margin-bottom: 28px;
        transition: color 0.15s;
      }
      .back-link:hover { color: var(--accent-hover); }

      @media (max-width: 640px) {
        .page { padding: 0 16px 32px; }
        .page-title { font-size: 1.35rem; }
        .topbar-crumb { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="page">

      <nav class="topbar">
        <a href="/graph" class="topbar-logo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          CHD API
        </a>
        <span class="topbar-sep">/</span>
        <div class="topbar-crumb">
          <a href="/graph">Estaciones</a>
          <span style="margin: 0 6px; color: var(--border)">/</span>
          <span><%= stationId.toUpperCase() %></span>
        </div>
      </nav>

      <a href="/graph" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
        </svg>
        Volver a la lista
      </a>

      <header class="page-header">
        <div class="station-id-badge"><%= stationId.toUpperCase() %></div>
        <h1 class="page-title"><%= stationInfo ? stationInfo['Descripción'] : stationId.toUpperCase() %></h1>
        <p class="page-subtitle">Confederación Hidrográfica del Duero · SAIH Duero</p>

        <% if (stationInfo) { %>
        <div class="meta-grid">
          <% if (stationInfo['Río']) { %>
          <div class="meta-item">
            <div class="meta-label">Río</div>
            <div class="meta-value"><%= stationInfo['Río'] %></div>
          </div>
          <% } %>
          <% if (stationInfo['Subcuenca']) { %>
          <div class="meta-item">
            <div class="meta-label">Subcuenca</div>
            <div class="meta-value"><%= stationInfo['Subcuenca'] %></div>
          </div>
          <% } %>
          <% if (stationInfo['Provincia']) { %>
          <div class="meta-item">
            <div class="meta-label">Provincia</div>
            <div class="meta-value"><%= stationInfo['Provincia'] %></div>
          </div>
          <% } %>
          <% if (stationInfo['Localización']) { %>
          <div class="meta-item">
            <div class="meta-label">Localización</div>
            <div class="meta-value"><%= stationInfo['Localización'] %></div>
          </div>
          <% } %>
        </div>
        <% } %>
      </header>

      <div class="section-title">Datos disponibles</div>

      <% if (detail && detail.length > 0) { %>
      <%
        // Build inverted map: scraped type name → URL slug
        const typeToSlug = {};
        Object.entries(typeSlugMap).forEach(([slug, typeName]) => { typeToSlug[typeName] = slug; });
      %>
      <div class="type-cards">
        <% detail.forEach(function(item) {
          const slug = typeToSlug[item.type] || item.type;
          const cssClass = slug.replace(/\s+/g, '-');
        %>
        <a href="/graph/<%= stationId %>/<%= slug %>" class="type-card card-<%= cssClass %>">
          <div class="type-icon">
            <% if (item.type === 'nivel') { %>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12c.5-1 1.5-2 3-2s2.5 1 3 2 1.5 2 3 2 2.5-1 3-2 1.5-2 3-2 2.5 1 3 2"/>
              <path d="M2 18c.5-1 1.5-2 3-2s2.5 1 3 2 1.5 2 3 2 2.5-1 3-2 1.5-2 3-2 2.5 1 3 2"/>
              <line x1="12" y1="2" x2="12" y2="8"/>
              <polyline points="9 5 12 2 15 5"/>
            </svg>
            <% } else if (item.type === 'caudal') { %>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
            <% } else if (item.type === 'temperatura ambiente') { %>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
            </svg>
            <% } else if (item.type === 'pluviometría') { %>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="8" y1="19" x2="8" y2="21"/><line x1="8" y1="13" x2="8" y2="15"/>
              <line x1="16" y1="19" x2="16" y2="21"/><line x1="16" y1="13" x2="16" y2="15"/>
              <line x1="12" y1="21" x2="12" y2="23"/><line x1="12" y1="15" x2="12" y2="17"/>
              <path d="M20 16.58A5 5 0 0 0 18 7h-1.26A8 8 0 1 0 4 15.25"/>
            </svg>
            <% } else { %>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
            </svg>
            <% } %>
          </div>
          <div class="type-body">
            <div class="type-name"><%= item.type %></div>
            <div class="type-desc">
              <% if (item.type === 'nivel') { %>Nivel del agua en el río
              <% } else if (item.type === 'caudal') { %>Caudal de agua circulante
              <% } else if (item.type === 'temperatura ambiente') { %>Temperatura del aire
              <% } else if (item.type === 'pluviometría') { %>Precipitación acumulada
              <% } else { %>Datos históricos disponibles
              <% } %>
            </div>
            <span class="type-unit">
              <% if (item.type === 'nivel') { %>m
              <% } else if (item.type === 'caudal') { %>m³/s
              <% } else if (item.type === 'temperatura ambiente') { %>°C
              <% } else if (item.type === 'pluviometría') { %>mm
              <% } else { %>—<% } %>
            </span>
          </div>
          <div class="type-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </div>
        </a>
        <% }); %>
      </div>
      <% } else { %>
      <div class="no-data">No hay datos disponibles para esta estación</div>
      <% } %>

    </div>
  </body>
</html>
