<!DOCTYPE html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estaciones · CHD</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-base:        #0d1117;
        --bg-surface:     #161b22;
        --bg-elevated:    #1c2128;
        --bg-subtle:      #21262d;
        --border:         #30363d;
        --border-muted:   #21262d;
        --text-primary:   #e6edf3;
        --text-secondary: #8b949e;
        --text-muted:     #6e7681;
        --accent:         #388bfd;
        --accent-hover:   #58a6ff;
        --accent-dim:     rgba(56, 139, 253, 0.15);
        --success:        #3fb950;
        --radius-sm:      6px;
        --radius-md:      10px;
        --radius-lg:      16px;
      }

      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg-base);
        color: var(--text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px 48px;
      }

      /* Topbar */
      .topbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
        margin-bottom: 32px;
      }

      .topbar-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
        text-decoration: none;
        letter-spacing: 0.02em;
      }
      .topbar-logo svg { color: var(--accent); }

      /* Header */
      .page-header { margin-bottom: 28px; }

      .page-title {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }
      .page-title span { color: var(--accent); }

      .page-subtitle {
        margin-top: 6px;
        font-size: 0.9rem;
        color: var(--text-secondary);
      }

      /* Search */
      .search-bar {
        margin-bottom: 20px;
        position: relative;
      }
      .search-bar svg {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
      }
      .search-input {
        width: 100%;
        max-width: 420px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        color: var(--text-primary);
        font-family: inherit;
        font-size: 0.875rem;
        padding: 10px 14px 10px 40px;
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .search-input::placeholder { color: var(--text-muted); }
      .search-input:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(56, 139, 253, 0.2);
      }

      /* Count badge */
      .count-badge {
        display: inline-flex;
        align-items: center;
        padding: 2px 10px;
        background: var(--accent-dim);
        color: var(--accent-hover);
        border: 1px solid rgba(56, 139, 253, 0.3);
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 10px;
        vertical-align: middle;
      }

      /* Table */
      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        background: var(--bg-surface);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
      }

      thead tr {
        border-bottom: 1px solid var(--border);
      }

      th {
        padding: 12px 16px;
        text-align: left;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        white-space: nowrap;
        background: var(--bg-elevated);
      }
      th:first-child { border-radius: var(--radius-lg) 0 0 0; }
      th:last-child  { border-radius: 0 var(--radius-lg) 0 0; }

      tbody tr {
        border-bottom: 1px solid var(--border-muted);
        transition: background 0.12s;
        cursor: pointer;
      }
      tbody tr:last-child { border-bottom: none; }
      tbody tr:hover { background: var(--bg-elevated); }
      tbody tr.hidden { display: none; }

      td {
        padding: 12px 16px;
        color: var(--text-primary);
        vertical-align: middle;
      }

      .station-id {
        font-family: 'SFMono-Regular', 'Consolas', monospace;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--accent-hover);
        background: var(--accent-dim);
        padding: 3px 8px;
        border-radius: var(--radius-sm);
        display: inline-block;
      }

      .td-name { font-weight: 500; }

      .td-meta { color: var(--text-secondary); }

      .td-province {
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      .arrow-cell {
        text-align: right;
        width: 40px;
        color: var(--text-muted);
      }
      tbody tr:hover .arrow-cell { color: var(--accent-hover); }

      .no-results {
        text-align: center;
        padding: 48px 16px;
        color: var(--text-muted);
        font-size: 0.9rem;
        display: none;
      }

      /* Responsive */
      @media (max-width: 640px) {
        .page { padding: 0 16px 32px; }
        .page-title { font-size: 1.35rem; }
        .hide-mobile { display: none; }
        th:first-child { border-radius: 0; }
        th:last-child  { border-radius: 0; }
      }
    </style>
  </head>
  <body>
    <div class="page">

      <nav class="topbar">
        <a href="/graph" class="topbar-logo">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          CHD API
        </a>
      </nav>

      <header class="page-header">
        <h1 class="page-title">
          Estaciones de <span>Aforo</span>
          <span class="count-badge"><%= stations.length %></span>
        </h1>
        <p class="page-subtitle">Confederación Hidrográfica del Duero · SAIH Duero</p>
      </header>

      <div class="search-bar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          type="text"
          class="search-input"
          id="search"
          placeholder="Buscar por nombre, río o provincia..."
          autocomplete="off"
        />
      </div>

      <div class="table-wrap">
        <table id="stations-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nombre</th>
              <th class="hide-mobile">Río</th>
              <th class="hide-mobile">Subcuenca</th>
              <th class="hide-mobile">Provincia</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% stations.forEach(function(s) { %>
            <tr data-search="<%= [s.stationId, s['Descripción'], s['Río'], s['Subcuenca'], s['Provincia']].join(' ').toLowerCase() %>" onclick="window.location='/graph/<%= s.stationId %>'">
              <td><span class="station-id"><%= s.stationId %></span></td>
              <td class="td-name"><%= s['Descripción'] %></td>
              <td class="td-meta hide-mobile"><%= s['Río'] %></td>
              <td class="td-meta hide-mobile"><%= s['Subcuenca'] %></td>
              <td class="td-province hide-mobile"><%= s['Provincia'] %></td>
              <td class="arrow-cell">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="no-results" id="no-results">No se encontraron estaciones</div>
      </div>

    </div>

    <script>
      const search = document.getElementById('search');
      const rows = document.querySelectorAll('#stations-table tbody tr');
      const noResults = document.getElementById('no-results');

      search.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        let visible = 0;
        rows.forEach(row => {
          const match = !q || row.dataset.search.includes(q);
          row.classList.toggle('hidden', !match);
          if (match) visible++;
        });
        noResults.style.display = visible === 0 ? 'block' : 'none';
      });
    </script>
  </body>
</html>
